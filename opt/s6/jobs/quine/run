#!/usr/bin/env -S -- bash -Eeuo pipefail -O dotglob -O nullglob -O extglob -O failglob -O globstar

set -o pipefail

BASE="${0%/jobs/quine/run}"
ADDED=0

for REQUEST in "$BASE"/jobs/*/data/@(oneshot|recurring)/*; do
  if ! [[ -f $REQUEST ]]; then
    continue
  fi
  KIND="${REQUEST%/*}"
  JOB="${KIND%/data/*}"
  KIND="${KIND##*/}"
  NAME="${JOB##*/}:$KIND:${REQUEST##*/}"
  DEST="$PWD/$NAME"
  if [[ -d $DEST ]]; then
    continue
  fi
  rsync --archive --relative -- "$BASE/base/./" "$JOB/./"en[v] "$DEST/"
  ln -sf -- "$JOB/run" "$DEST/data/job"
  if [[ $KIND == recurring ]]; then
    ln -sf -- recurring/.runner.sh "$DEST/data/.runner.sh"
  fi
  ADDED=1
done

if ((ADDED)) && (($#)); then
  exec -- s6-svscanctl -a "$PWD"
fi
