{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/yes.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/rules.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/rules.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash|apply_patch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/banned-tools.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/bash-steer.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/run-post.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash|apply_patch"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/sessions.sh",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/workspace.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/rules.sh",
            "type": "command"
          }
        ],
        "matcher": "startup|clear"
      },
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/sessions.sh",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/auto-commit.sh",
            "type": "command"
          },
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/sessions.sh",
            "type": "command"
          },
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/rules.sh",
            "type": "command"
          },
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/run-post.sh",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/auto-commit.sh",
            "type": "command"
          },
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/sessions.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/sessions.sh",
            "type": "command"
          },
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/rules.sh",
            "type": "command"
          }
        ]
      }
    ]
  }
}
