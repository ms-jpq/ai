{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/rules.sh",
            "type": "command"
          }
        ],
        "matcher": "Read|Write|Edit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/bash-steer.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/rules.sh",
            "type": "command"
          }
        ],
        "matcher": "startup|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/auto-commit.sh",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "~/.local/opt/ai/opt/codex/hooks/auto-commit.sh",
            "type": "command"
          }
        ]
      }
    ]
  }
}
