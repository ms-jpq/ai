#!/usr/bin/env -S -- gvpr -c -f

BEGIN {
  string basename(string basename_path) {
    return substr(basename_path, rindex(basename_path, "/") + 1);
  }

  string dirname(string dirname_path) {
    int separator = rindex(dirname_path, "/");
    return separator < 0 ? "." : substr(dirname_path, 0, separator);
  }

  string target_key(string directory, int incoming) {
    if (directory == ".") {
      return "graph";
    }
    string node_id = basename(directory);
    if (node_id != ".*") {
      return "node/" + node_id;
    }
    string source_directory = dirname(directory);
    string source_id = basename(source_directory);
    string target_id = substr(node_id, 1);
    return incoming ? "edge/" + target_id + "/" + source_id : "edge/" + source_id + "/" + target_id;
  }

  string attributes[string];
  int seen[string];

  void load_metadata(string metadata_file, int incoming) {
    string records[string];
    int descriptor = openF(metadata_file, "r");
    if (descriptor < 0) {
      printf(2, "Cannot read %s\n", metadata_file);
      exit(1);
    }
    string line;
    while (strcmp(line = readL(descriptor), "")) {
      if (substr(line, length(line) - 1) == "\n") {
        line = substr(line, 0, length(line) - 1);
      }
      int separator = index(line, "=:");
      if (separator < 0) {
        continue;
      }
      string key = substr(line, 0, separator + 1);
      records[key] = substr(line, separator + 2);
    }
    closeF(descriptor);
    string path;
    for (records[path]) {
      string filename = basename(path);
      if (filename != ".?*=") {
        continue;
      }
      string attribute = substr(filename, 1, length(filename) - 2);
      string directory = dirname(path);
      string target = target_key(directory, incoming);
      attributes[target] += attribute + "=:" + records[path] + "\n";
    }
  }

  void apply_attributes(obj_t subject, string key) {
    if (!(key in attributes)) {
      return;
    }
    seen[key] = 1;
    string lines[int];
    int count = tokens(attributes[key], lines, "\n");
    int i;
    for (i = 0; i < count; i++) {
      int separator = index(lines[i], "=:");
      aset(subject, substr(lines[i], 0, separator), substr(lines[i], separator + 2));
    }
  }

  if (ARGC != 2 || (ARGV[0] != "outgoing" && ARGV[0] != "incoming")) {
    printf(2, "Usage: fs-annotate.gvpr -a \"outgoing|incoming '<metadata>'\" < topology.gv\n");
    exit(2);
  }

  int incoming = ARGV[0] == "incoming";
  load_metadata(ARGV[1], incoming);
}

BEG_G {
  unset(seen);
  apply_attributes($G, "graph");
}

N {
  string node_key = "node/" + $.name;
  apply_attributes($, node_key);
}

E {
  string edge_key = "edge/" + $.tail.name + "/" + $.head.name;
  apply_attributes($, edge_key);
}

END_G {
  string key;
  for (attributes[key]) {
    if (!(key in seen)) {
      printf(2, "No graph object for %s\n", key);
      exit(1);
    }
  }
}
