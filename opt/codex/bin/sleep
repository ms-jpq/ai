#!/usr/bin/env -S -- bash -Eeuo pipefail -O dotglob -O nullglob -O extglob -O failglob -O globstar

set -o pipefail

REASON=''
ARGS=()
while (($#)); do
  case "$1" in
  --reason-for-duration=*)
    REASON="${1#*=}"
    shift -- 1
    ;;
  --reason-for-duration)
    shift -- 1
    if (($#)); then
      REASON="$1"
      shift -- 1
    fi
    ;;
  *)
    ARGS+=("$1")
    shift -- 1
    ;;
  esac
done

if [[ -z $REASON ]]; then
  tee -- >&2 <<- EOF
<system-reminder>
This is a shim binary.

'sleep' blocks an interactive session while time passes on its own.
Provide --reason-for-duration=<reason> to explain why the requested duration is necessary, or use a non-blocking wait mechanism.

If 'sleep' is unavoidable, prefer to sleep for less, rather than more time.
</system-reminder>
EOF
  exit 2
fi

exec -- /bin/sleep "${ARGS[@]}"
